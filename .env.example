# ============================================================
# NUJ India — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ============================================================

# Django Core
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Admin URL (change for security in production)
ADMIN_URL=nuj-admin/

# Database (PostgreSQL for production)
DB_NAME=nujindia
DB_USER=nujindia_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# Site URL
SITE_URL=https://nujindia.org

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NUJ India <noreply@nujindia.org>
SERVER_EMAIL=errors@nujindia.org

# NUJ Specific Emails
MEMBERSHIP_EMAIL=membership@nujindia.org
CONTACT_EMAIL=contact@nujindia.org

# Cache (Redis URL for production)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
REDIS_URL=redis://localhost:6379/1

# Media / Storage
MEDIA_ROOT=/var/www/nujindia/media/

# Security (set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
