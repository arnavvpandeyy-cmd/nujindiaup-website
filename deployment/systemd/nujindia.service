# NUJ India — Gunicorn systemd service
# Place at: /etc/systemd/system/nujindia.service
# Then: sudo systemctl enable nujindia && sudo systemctl start nujindia

[Unit]
Description=NUJ India — Gunicorn Django Application
After=network.target postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/nujindia
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
EnvironmentFile=/var/www/nujindia/.env
ExecStart=/var/www/nujindia/venv/bin/gunicorn \
    --workers 4 \
    --worker-class sync \
    --bind unix:/run/nujindia/gunicorn.sock \
    --log-level info \
    --access-logfile /var/log/nujindia/gunicorn_access.log \
    --error-logfile /var/log/nujindia/gunicorn_error.log \
    --capture-output \
    --timeout 60 \
    config.wsgi:application

RuntimeDirectory=nujindia
RuntimeDirectoryMode=0755

# Restart on failure
Restart=on-failure
RestartSec=5s

# Security hardening
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/nujindia/media /var/www/nujindia/logs /var/log/nujindia

[Install]
WantedBy=multi-user.target
